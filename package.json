{
  "name": "burak-kul-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "dev:all": "sh -c 'node server/index.mjs & P=$!; trap \"kill $P\" EXIT; vite'",
    "start": "npm run build && node server/index.mjs",
    "mobile:dev": "vite --config mobile-admin/vite.config.ts",
    "mobile:build": "vite build --config mobile-admin/vite.config.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "typescript": "^7.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}
